{
  "name": "simulation-milk-process",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based 3D simulation of a UHT milk plant, from standardization to ambient distribution.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:assets",
    "test:assets": "node --test assets/scripts/*.test.mjs"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "lil-gui": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
